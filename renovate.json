{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["every weekend"],
  "labels": ["dependencies", "renovate"],
  "assignees": ["Guppy997"],
  "enabledManagers": ["helmv3", "argocd", "docker-compose", "kubernetes"],
  "helmv3": {
    "fileMatch": [
      "managed-service-catalog/helm/.+/Chart\\.yaml$",
      "clusters/dev/apps/.+/Chart\\.yaml$"
    ]
  },
  "argocd": {
    "fileMatch": [
      "clusters/dev/apps/.+\\.yaml$"
    ]
  },
  "docker-compose": {
    "fileMatch": ["\\.yml$", "\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": [
      "clusters/dev/apps/.+/manifests/.+\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch updates for Helm and k8s manifests",
      "matchUpdateTypes": ["patch"],
      "matchManagers": ["helmv3", "argocd", "kubernetes"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group all kube-prometheus-stack updates",
      "matchPackageNames": ["kube-prometheus-stack"],
      "groupName": "kube-prometheus-stack"
    },
    {
      "description": "Group all kyverno updates",
      "matchPackageNames": ["kyverno", "kyverno-policies", "kyverno-policy-reporter"],
      "groupName": "kyverno"
    },
    {
      "description": "Ignore Plane images: latest tag only, versioned images have incompatible architecture changes",
      "matchPackagePatterns": ["makeplane/plane-.*"],
      "enabled": false
    },
    {
      "description": "Group minio server + mc together",
      "matchPackageNames": ["minio/minio", "minio/mc"],
      "groupName": "minio"
    },
    {
      "description": "Ignore minio/minio: data format changes between major versions can break existing data",
      "matchPackageNames": ["minio/minio"],
      "enabled": false
    },
    {
      "description": "Ignore AFFiNE stable tag (floating channel, no trackable version)",
      "matchPackageNames": ["ghcr.io/toeverything/affine"],
      "enabled": false
    },
    {
      "description": "Ignore beszel latest tag (no semver release tags available)",
      "matchPackageNames": ["docker.io/henrygd/beszel", "henrygd/beszel"],
      "enabled": false
    }
  ]
}

# Read by `kubara bootstrap` (godotenv: KEY=value, no quotes).
# bootstrap.sh generates the real .env from host/kubara.env plus the
# SOPS-encrypted clusters/dev/secrets/kubara-env-secret.yaml; .env stays out of Git.

# Project name, used as prefix for the Argo CD applications
PROJECT_NAME=luna-sovereign-mesh
# Stage name from config.yaml
PROJECT_STAGE=dev
# Repository Argo CD pulls from
ARGOCD_GIT_HTTPS_URL=https://github.com/<owner>/luna-sovereign-mesh.git
# GitHub user that owns the token below
ARGOCD_GIT_USERNAME=<github-user>
# GitHub token with read access to the repository (secret)
ARGOCD_GIT_PAT_OR_PASSWORD=
# Password for the Argo CD wizard account (secret)
ARGOCD_WIZARD_ACCOUNT_PASSWORD=
# Internal base domain
DOMAIN_NAME=luna-sovereign-mesh-dev.example.local
